%% WASAC — Billing & Payment Flow
%% Render: https://mermaid.live

flowchart LR
    subgraph Setup["1. Setup (Admin)"]
        T1[Create WATER FLAT tariff]
        T2[Create ELECTRICITY TIERED tariff]
    end

    subgraph Ops["2. Operations (Operator)"]
        M1[Assign meters WM / EM]
        R1[Capture meter reading]
    end

    subgraph Auto["3. Auto-generation"]
        BG[BillService.generate]
        EM1[Email: bill generated]
        N1[(Notification BILL_GENERATED)]
    end

    subgraph Finance["4. Finance workflow"]
        AP[POST /bills/id/approve]
        EM2[Email: bill approved]
        AL[(Audit BILL_APPROVED)]
        PAY[POST /payments]
        ST{Outstanding?}
    end

    subgraph Penalty["5. Background cron"]
        CRON[LatePenaltyScheduler<br/>daily 02:00]
        PEN[applyLatePenalty]
        EM3[Email: late payment warning]
    end

    T1 --> M1
    T2 --> M1
    M1 --> R1
    R1 --> BG
    BG --> EM1
    BG --> N1
    BG --> AP
    AP --> EM2
    AP --> AL
    AP --> PAY
    PAY --> ST
    ST -->|balance > 0| PARTIAL[PARTIALLY_PAID]
    ST -->|balance = 0| PAID[PAID]
    PARTIAL --> CRON
    AP --> CRON
    CRON --> PEN
    PEN --> EM3

    style CRON fill:#ffe4b5,stroke:#cc8800
    style PEN fill:#ffe4b5,stroke:#cc8800
