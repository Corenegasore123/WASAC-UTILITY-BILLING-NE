flowchart TB
    subgraph Clients["Client Layer"]
        SW[Swagger UI]
        WEB[Web / Mobile Client]
        PS[Postman / curl]
    end

    subgraph API["API Layer — Spring Boot 4 / Java 21"]
        AUTH["/api/auth/**"]
        USR["/api/users"]
