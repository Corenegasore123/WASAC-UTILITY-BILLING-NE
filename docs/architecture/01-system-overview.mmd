        TAR["/api/tariffs"]
        BIL["/api/bills"]
        PAY["/api/payments"]
        NOT["/api/notifications"]
        AUD["/api/audit-logs"]
    end

    subgraph Security["Security Layer"]
        JWT[JWT Filter]
        RBAC["@PreAuthorize Roles"]
        PWD[Password Change Filter]
    end

    subgraph Services["Service Layer"]
        AuthSvc[AuthService]
        UserSvc[UserService]
        CustSvc[CustomerService]
        MeterSvc[MeterService]
