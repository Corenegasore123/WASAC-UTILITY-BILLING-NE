%% WASAC — Spring Boot Component Diagram
%% Render: https://mermaid.live

graph TB
    subgraph Controllers
        AuthC[AuthController]
        UserC[UserController]
        CustC[CustomerController]
        MeterC[MeterController]
        ReadC[MeterReadingController]
        TariffC[TariffController]
        BillC[BillController]
        PayC[PaymentController]
        NotifC[NotificationController]
        AuditC[AuditLogController]
    end

    subgraph Config
        SecC[SecurityConfig + JWT]
        SchedC[SchedulingConfig]
        DataI[DataInitializer]
        DbR[DatabaseRoutineInitializer]
        OpenAPI[OpenApiConfig]
    end

    subgraph CoreServices
        AuthS[AuthService]
        UserS[UserService]
        CustS[CustomerService]
        MeterS[MeterService]
        ReadS[MeterReadingService]
        TariffS[TariffService]
        BillS[BillService]
        PayS[PaymentService]
        NotifS[NotificationService]
        AuditS[AuditService]
        EmailS[EmailService]
    end

    subgraph Scheduler
        LateP[LatePenaltyScheduler<br/>@Scheduled cron]
    end

    subgraph Repositories
        UserR[(AppUserRepository)]
        CustR[(CustomerRepository)]
        MeterR[(MeterRepository)]
        ReadR[(MeterReadingRepository)]
        TariffR[(TariffPlanRepository)]
        BillR[(BillRepository)]
        PayR[(PaymentRepository)]
        NotifR[(NotificationRepository)]
        AuditR[(AuditLogRepository)]
        OtpR[(OtpVerificationRepository)]
    end

    subgraph Database
        PG[(PostgreSQL wasac_db)]
    end

